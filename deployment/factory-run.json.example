{
  "run_kind": "sample_production",
  "planning_strategy": "auto",
  "context": {
    "candidate_ph_ids": [
      "PH-IA01",
      "PH-OB05",
      "PH-IN04"
    ],
    "required_ph_ids": [
      "PH-IA01",
      "PH-IN04"
    ],
    "production_policy": "baseline",
    "profile": {
      "profile_id": "REPLACE_WITH_MATERIALIZED_FACTORY_PROFILE",
      "env_detail": {
        "os_build": "REPLACE_WITH_PINNED_OS_BUILD",
        "sysmon": "REPLACE_WITH_PINNED_SYSMON_VERSION",
        "ami_or_snapshot": "REPLACE_WITH_MATERIALIZED_IMAGE"
      },
      "security_product_enabled": false,
      "high_risk_enabled": false,
      "isolated": false,
      "rollback_capable": false,
      "sensors_ready": false,
      "no_edr_control": true
    },
    "delivery": "motw-stamped(lab)",
    "trigger_mode": "lab_trigger",
    "seed": 42,
    "failure_priors": []
  },
  "worker_id": "REPLACE_WITH_FACTORY_WORKER_ID",
  "workspace_ref": "plugin-workspace://REPLACE_WITH_PINNED_WORKSPACE",
  "build_target_ref": "build-target://REPLACE_WITH_OPERATOR_TARGET",
  "regression_set_version": "example-v1",
  "execution_logging": false,
  "batch": {
    "sample_count": 1,
    "max_attempts": 3,
    "continue_on_failure": true
  },
  "lease_ttl_seconds": 900,
  "compile_attempt_limit": 3
}
