# deployment/secrets.env.example —— 复制为 deployment/secrets.env 并 chmod 600
# 契约：docs/superpowers/specs/2026-08-22-unified-runtime-config.md §4
# 纪律：按数据文件解析（禁 export/未知键/重复键/命令替换）；值按字面（不剥引号）；
#       永不 git 入库（.gitignore 防线 **/secrets.env）。
# 写入手法：read -rsp 'Key: ' K && printf '%s=%s\n' LLM_API_KEY "$K" >> deployment/secrets.env && unset K
#
# 工厂 PostgreSQL combo_state（DSN 不进本文件封闭键集）：
#   优先：FACTORY_POSTGRES_DSN=postgresql://…  或  FACTORY_POSTGRES_DSN_FILE=<0600 文件>
#   或：在 SECRET_STORE_DIR 下放文件 db/factory-combo-dsn（单行 DSN），
#       由 create_postgres_state_backend 解析 secret://db/factory-combo-dsn

SECRET_STORE_DIR=/etc/edreval/secrets
LLM_API_KEY=<dedicated-revocable-key>
